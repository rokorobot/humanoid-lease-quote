#!/usr/bin/env bash
# integration_twins gate: tests against a real Postgres. They empty tables, so the
# database name must end in _test.
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/require-db
db_name="${DATABASE_URL##*/}"; db_name="${db_name%%\?*}"
case "$db_name" in
  *_test) ;;
  *) echo "test-integration: refusing to run against '$db_name'. These tests delete data." >&2
     echo "Fix: point DATABASE_URL at a database whose name ends in _test." >&2
     exit 1 ;;
esac
npx prisma generate >/dev/null
npx prisma migrate deploy
npx vitest run --config vitest.integration.config.mts
